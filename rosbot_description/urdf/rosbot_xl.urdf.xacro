<?xml version='1.0'?>
<robot name="rosbot_xl" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="components_config" default="$(find rosbot_description)/config/components.yaml" />
  <xacro:arg name="controller_config" default="$(find rosbot_controller)/config/diff_drive_controller.yaml" />
  <xacro:arg name="include_camera_mount" default="false" />
  <xacro:arg name="mecanum" default="false" />
  <xacro:arg name="namespace" default="" />
  <xacro:arg name="use_sim" default="false" />

  <xacro:include filename="$(find rosbot_description)/urdf/rosbot_xl/rosbot_macro.urdf.xacro"
    ns="husarion" />
  <xacro:husarion.rosbot_robot
    controller_config="$(arg controller_config)"
    mecanum="$(arg mecanum)"
    namespace="$(arg namespace)"
    use_sim="$(arg use_sim)" />

  <xacro:if value="$(arg include_camera_mount)">
    <xacro:include filename="$(find rosbot_description)/urdf/rosbot_xl/components/camera_mount.urdf.xacro" ns="camera_mount" />
    <xacro:camera_mount.camera_mount
      parent_link="cover_link"
      xyz="-0.1 0.0 0.0"
      rpy="0.0 0.0 0.0"
      camera_mount_angle_1="0.0"
      camera_mount_angle_2="0.0" />
  </xacro:if>

  <xacro:include filename="$(find ros_components_description)/urdf/components.urdf.xacro" ns="components" />
  <xacro:components.create_components
    components_config_path="$(arg components_config)"
    namespace=""
  />
</robot>
